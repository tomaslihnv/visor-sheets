{
  "name": "visor-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --outDir dist --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run",
    "publicar": "vitest run && tsc --noEmit && node -e \"require('fs').rmSync('../assets',{recursive:true,force:true})\" && vite build --outDir .. --emptyOutDir false"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "firebase": "^13.2.0",
    "html-to-image": "^1.11.11",
    "jspdf": "^4.2.1",
    "papaparse": "^5.7.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
